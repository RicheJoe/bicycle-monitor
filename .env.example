# 复制为 api/.env 后填写。本文件不放可用口令。
# docker compose 与 Prisma、api 都读 api/.env。

POSTGRES_USER=bicycle
POSTGRES_PASSWORD=
POSTGRES_DB=bicycle
DATABASE_URL=postgresql://bicycle:PASSWORD@localhost:5432/bicycle

REDIS_URL=redis://localhost:6379

RABBITMQ_DEFAULT_USER=bicycle
RABBITMQ_DEFAULT_PASS=
RABBITMQ_URL=amqp://bicycle:PASSWORD@localhost:5672

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
SIMULATOR_MQTT_USERNAME=
SIMULATOR_MQTT_PASSWORD=

EMQX_DASHBOARD__DEFAULT_USERNAME=admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=
EMQX_API_URL=http://127.0.0.1:18083
EMQX_WEBHOOK_SECRET=

JWT_SECRET=
WECHAT_APPID=
WECHAT_SECRET=

SEED_ANCHOR_LAT=31.230416
SEED_ANCHOR_LNG=121.473701
HTTP_PORT=3000
INTERNAL_PORT=3001
NODE_ENV=development
